{
  "name": "@ctliz/agent-intercom-core",
  "version": "0.2.0",
  "description": "Shared security policy kernel and protocol primitives for Agent Intercom",
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ctliz/agent-intercom-core.git"
  },
  "homepage": "https://github.com/ctliz/agent-intercom-core#readme",
  "bugs": {
    "url": "https://github.com/ctliz/agent-intercom-core/issues"
  },
  "files": [
    "dist",
    "docs/standalone-v4-acceptance.md",
    "PROTOCOL-V4-DESIGN.md",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./policy": {
      "types": "./dist/policy.d.ts",
      "import": "./dist/policy.js"
    },
    "./vectors": {
      "types": "./dist/policy-vectors.d.ts",
      "import": "./dist/policy-vectors.js"
    },
    "./canonical": {
      "types": "./dist/canonical.d.ts",
      "import": "./dist/canonical.js"
    },
    "./protocol-v4": {
      "types": "./dist/protocol-v4.d.ts",
      "import": "./dist/protocol-v4.js"
    },
    "./boss": {
      "types": "./dist/boss.d.ts",
      "import": "./dist/boss.js"
    },
    "./boss/policy": {
      "types": "./dist/boss-policy.d.ts",
      "import": "./dist/boss-policy.js"
    },
    "./boss/vectors": {
      "types": "./dist/boss-vectors.d.ts",
      "import": "./dist/boss-vectors.js"
    },
    "./team-manifest": {
      "types": "./dist/team-manifest.d.ts",
      "import": "./dist/team-manifest.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "verify": "npm run typecheck && npm test && npm run build && node test/package-smoke.mjs"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
